<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <Company>Tableau Software</Company>
    <Authors>Customer Data Platform</Authors>
    <Product>LogShark</Product>
    <Description>Application used to process Tableau logs to gather useful information about errors</Description>
    <Copyright>Copyright © 2020</Copyright>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Flurl.Http" Version="4.0.2" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="3.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Tableau.HyperAPI.NET" Version="0.0.17971" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Config\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Workbooks\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Remove="Output\**" />
    <None Remove="Logs\**" />
    <None Remove="TestLogs\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Output\**" />
    <Compile Remove="Logs\**" />
    <Compile Remove="TestLogs\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Output\**" />
    <EmbeddedResource Remove="Logs\**" />
    <EmbeddedResource Remove="TestLogs\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Workbooks" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LogShark.Shared\LogShark.Shared.csproj" />
  </ItemGroup>
  <!-- Internal-only package references live in this file. It is not part of the public export, where the export supplies an equivalent reference instead. -->
  <Import Project="LogShark.Private.props" Condition="Exists('LogShark.Private.props')" />
  <Import Project="LogShark.Public.props" Condition="Exists('LogShark.Public.props')" />
</Project>